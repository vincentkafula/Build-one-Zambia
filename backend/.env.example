# Build One Zambia — Backend Environment Variables
# Copy this to .env and customise before running in production

# Server port
PORT=3001

# ── Required for the app to start safely ────────────────────────────────────

# JWT secret — CHANGE THIS to a long random string in production. If unset,
# a random one is generated at boot, which invalidates every login on
# restart. Never reuse the example value below in a real deployment.
JWT_SECRET=boz-jwt-secret-change-in-production-2024

# Super-admin credentials (env-based login, bypasses DB) — CHANGE THESE
# before deploying. If ADMIN_PASSWORD is unset, the shortcut login is
# disabled entirely rather than falling back to a known default, since
# this repo is public.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_unique_password

# PIN required for admin actions that ask for a confirmation PIN
ADMIN_PIN=

# ── Required for specific features ───────────────────────────────────────────
# The app runs without these, but the feature each one powers won't work.

# Payments (Flutterwave, https://flutterwave.com) — without these, checkout
# card/mobile-money payment fails
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# SMS OTP verification (Twilio Verify, https://twilio.com) — without these,
# phone verification during registration fails
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Resend (https://resend.com) API key — required for OTP emails AND for
# emailing every submitted application (details + documents) to info@bozplans.org
RESEND_API_KEY=

# Address the application/OTP emails are sent FROM (must be a domain verified in Resend)
EMAIL_FROM_ADDRESS=no-reply@bozplans.org
EMAIL_FROM_NAME=Build One Zambia

# Durable Postgres persistence — without this, data only lives in the
# in-memory store + a local JSON file, which is lost on redeploy on most
# hosts (Railway's filesystem is ephemeral). Strongly recommended for any
# real deployment.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=https://www.bozplans.org,https://bozplans.org

# Used to build links inside outgoing emails (password reset, verification, etc.)
SITE_URL=https://www.bozplans.org
BACKEND_URL=https://api.bozplans.org
VERIFY_BASE_URL=https://www.bozplans.org
